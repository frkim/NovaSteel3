{
  "name": "novasteel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/analytics-mfe"
  ],
  "scripts": {
    "build": "npm run build:analytics && npm run build:portal",
    "build:analytics": "npm --workspace @novasteel/analytics-mfe run build",
    "test:frontend": "npm --workspace @novasteel/analytics-mfe run test",
    "lint:frontend": "npm --workspace @novasteel/analytics-mfe run lint",
    "restore:portal": "dotnet restore apps/portal-shell/PortalShell.csproj --configfile NuGet.Config",
    "build:portal": "dotnet build apps/portal-shell/PortalShell.csproj --no-restore",
    "test:bff": "set \"PIP_CONFIG_FILE=%CD%\\pip.conf\"&& set \"PIP_INDEX_URL=https://packagefeedproxy.microsoft.io/pypi/simple\"&& services\\bff-api\\.venv\\Scripts\\python.exe -m pytest services\\bff-api\\tests",
    "run:bff": "set \"PIP_CONFIG_FILE=%CD%\\pip.conf\"&& set \"PIP_INDEX_URL=https://packagefeedproxy.microsoft.io/pypi/simple\"&& set \"DEMO_MODE=local\"&& set \"PYTHONPATH=%CD%\\services\\bff-api\\src\"&& services\\bff-api\\.venv\\Scripts\\python.exe -m uvicorn bff_api.main:app --port 8080"
  }
}
