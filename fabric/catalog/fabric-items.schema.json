{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novasteel.example/schemas/fabric-items.schema.json",
  "title": "NovaSteel Fabric item catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaces", "items", "manualAssets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "workspaces": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "purpose", "parameterPath"],
        "properties": {
          "key": { "type": "string" },
          "purpose": { "type": "string" },
          "parameterPath": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "displayName",
          "workspaceKey",
          "automationTier",
          "restCollection",
          "dependencies",
          "manualGates"
        ],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
          "type": { "type": "string" },
          "displayName": { "type": "string" },
          "description": { "type": "string", "maxLength": 256 },
          "workspaceKey": { "type": "string" },
          "automationTier": {
            "enum": [
              "automatic",
              "automaticAfterTenantGate",
              "automaticAfterBindingGate"
            ]
          },
          "deploymentOption": { "type": "string" },
          "restCollection": { "type": "string", "pattern": "^/[A-Za-z]+$" },
          "sourceDirectory": { "type": ["string", "null"] },
          "definitionFormat": { "type": ["string", "null"] },
          "definitionParts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "createWithoutDefinition": { "type": "boolean" },
          "cliDeployable": { "type": "boolean" },
          "bindingGate": { "type": ["string", "null"] },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "manualGates": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "manualAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "assetType", "sourcePath", "reason", "completionEvidence"],
        "properties": {
          "key": { "type": "string" },
          "assetType": { "type": "string" },
          "sourcePath": { "type": "string" },
          "reason": { "type": "string" },
          "completionEvidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
