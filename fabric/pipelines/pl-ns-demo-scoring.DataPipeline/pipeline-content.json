{
  "properties": {
    "description": "Synthetic-only scoring orchestration; hard-disabled for prod by notebook and environment policy.",
    "activities": [
      {
        "name": "Deterministic_Demo_Scoring",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 60,
          "secureInput": false,
          "secureOutput": false
        },
        "typeProperties": {
          "notebookId": "{{item.notebookDemoScoring.id}}",
          "workspaceId": "{{workspace.ml.id}}",
          "parameters": {
            "ENVIRONMENT": { "value": "{{environment}}", "type": "string" },
            "CORE_TABLES_URI": { "value": "{{onelake.coreTablesUri}}", "type": "string" }
          }
        }
      },
      {
        "name": "Validate_Demo_Cues",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Deterministic_Demo_Scoring",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 60,
          "secureInput": false,
          "secureOutput": false
        },
        "typeProperties": {
          "notebookId": "{{item.notebookDataQuality.id}}",
          "workspaceId": "{{workspace.dataCore.id}}",
          "parameters": {
            "ENVIRONMENT": { "value": "{{environment}}", "type": "string" },
            "LANDING_TABLES_URI": { "value": "{{onelake.landingTablesUri}}", "type": "string" },
            "CORE_TABLES_URI": { "value": "{{onelake.coreTablesUri}}", "type": "string" }
          }
        }
      }
    ]
  }
}
