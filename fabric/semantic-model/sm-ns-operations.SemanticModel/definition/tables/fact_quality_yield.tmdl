table fact_quality_yield
	column date_key
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: date_key

	column plant_id
		dataType: string
		summarizeBy: none
		sourceColumn: plant_id

	column grade_code
		dataType: string
		summarizeBy: none
		sourceColumn: grade_code

	column high_grade_flag
		dataType: boolean
		summarizeBy: none
		sourceColumn: high_grade_flag

	column attempted_tons
		dataType: double
		summarizeBy: sum
		sourceColumn: attempted_tons

	column first_pass_good_tons
		dataType: double
		summarizeBy: sum
		sourceColumn: first_pass_good_tons

	column defect_count
		dataType: int64
		summarizeBy: sum
		sourceColumn: defect_count

	column produced_units
		dataType: int64
		summarizeBy: sum
		sourceColumn: produced_units

	column open_ncr_count
		dataType: int64
		summarizeBy: sum
		sourceColumn: open_ncr_count

	partition fact_quality_yield = entity
		mode: directLake
		source
			entityName: fact_quality_yield
			schemaName: dbo
