-- Authoritative NovaSteel semantic measure pack.
-- Target rows are filtered by report/environment context.

MEASURE 'dim_kpi_target'[Total Energy GJ] =
    SUM('fact_energy_daily'[energy_gj])

MEASURE 'dim_kpi_target'[Crude Steel Tons] =
    SUM('fact_energy_daily'[crude_steel_tons])

MEASURE 'dim_kpi_target'[KPI-ENE-01 SEC GJ per t] =
    DIVIDE([Total Energy GJ], [Crude Steel Tons])

MEASURE 'dim_kpi_target'[KPI-ENE-01 Baseline GJ per t] =
    CALCULATE(
        MAX('dim_kpi_target'[baseline_value]),
        KEEPFILTERS('dim_kpi_target'[kpi_id] = "KPI-ENE-01")
    )

MEASURE 'dim_kpi_target'[KPI-ENE-01 Reduction vs Baseline] =
    DIVIDE(
        [KPI-ENE-01 Baseline GJ per t] - [KPI-ENE-01 SEC GJ per t],
        [KPI-ENE-01 Baseline GJ per t]
    )

MEASURE 'dim_kpi_target'[KPI-ENE-02 Energy Cost Avoidance EUR] =
    SUMX(
        FILTER(
            'fact_dispatch_recommendation',
            'fact_dispatch_recommendation'[status] IN {"ACCEPTED", "MODIFIED"}
        ),
        COALESCE(
            'fact_dispatch_recommendation'[realized_cost_avoidance_eur],
            'fact_dispatch_recommendation'[expected_cost_avoidance_eur]
        )
    )

MEASURE 'dim_kpi_target'[KPI-ENE-03 Dispatch Acceptance Rate] =
    DIVIDE(
        CALCULATE(
            COUNTROWS('fact_dispatch_recommendation'),
            'fact_dispatch_recommendation'[status] IN {"ACCEPTED", "MODIFIED"}
        ),
        COUNTROWS('fact_dispatch_recommendation')
    )

MEASURE 'dim_kpi_target'[Total CO2e t] =
    SUM('fact_emissions_daily'[total_co2e_t])

MEASURE 'dim_kpi_target'[Emissions Crude Steel Tons] =
    SUM('fact_emissions_daily'[crude_steel_tons])

MEASURE 'dim_kpi_target'[KPI-CO2-01 Specific CO2 t per t] =
    DIVIDE([Total CO2e t], [Emissions Crude Steel Tons])

MEASURE 'dim_kpi_target'[KPI-CO2-01 Baseline t per t] =
    CALCULATE(
        MAX('dim_kpi_target'[baseline_value]),
        KEEPFILTERS('dim_kpi_target'[kpi_id] = "KPI-CO2-01")
    )

MEASURE 'dim_kpi_target'[KPI-CO2-01 Reduction vs Baseline] =
    DIVIDE(
        [KPI-CO2-01 Baseline t per t] - [KPI-CO2-01 Specific CO2 t per t],
        [KPI-CO2-01 Baseline t per t]
    )

MEASURE 'dim_kpi_target'[KPI-CO2-02 ETS Exposure EUR] =
    SUM('fact_emissions_daily'[ets_exposure_eur])

MEASURE 'dim_kpi_target'[KPI-FUR-01 Lining Lead Time Days] =
    AVERAGEX(
        FILTER(
            'fact_furnace_rul',
            NOT ISBLANK('fact_furnace_rul'[alert_issued_at])
                && NOT ISBLANK('fact_furnace_rul'[actual_reline_or_failure_at])
        ),
        DATEDIFF(
            'fact_furnace_rul'[alert_issued_at],
            'fact_furnace_rul'[actual_reline_or_failure_at],
            DAY
        )
    )

MEASURE 'dim_kpi_target'[KPI-FUR-02 Unplanned Outages Rolling 12M] =
    CALCULATE(
        COUNTROWS('fact_furnace_rul'),
        'fact_furnace_rul'[unplanned_outage_flag] = TRUE(),
        DATESINPERIOD(
            'dim_calendar'[date_key],
            MAX('dim_calendar'[date_key]),
            -12,
            MONTH
        )
    )

MEASURE 'dim_kpi_target'[KPI-FUR-03 RUL Precision] =
    DIVIDE(
        SUM('fact_model_evaluation'[true_positive]),
        SUM('fact_model_evaluation'[true_positive])
            + SUM('fact_model_evaluation'[false_positive])
    )

MEASURE 'dim_kpi_target'[KPI-FUR-03 RUL Recall] =
    DIVIDE(
        SUM('fact_model_evaluation'[true_positive]),
        SUM('fact_model_evaluation'[true_positive])
            + SUM('fact_model_evaluation'[false_negative])
    )

MEASURE 'dim_kpi_target'[KPI-QUA-01 High-Grade Yield Rate] =
    DIVIDE(
        CALCULATE(
            SUM('fact_quality_yield'[first_pass_good_tons]),
            'fact_quality_yield'[high_grade_flag] = TRUE()
        ),
        CALCULATE(
            SUM('fact_quality_yield'[attempted_tons]),
            'fact_quality_yield'[high_grade_flag] = TRUE()
        )
    )

MEASURE 'dim_kpi_target'[KPI-QUA-02 Claims per Ton Shipped] =
    DIVIDE(
        SUM('fact_customer_claim'[non_conformance_count]),
        SUM('fact_customer_claim'[tons_shipped])
    )

MEASURE 'dim_kpi_target'[KPI-KNW-01 Procedure Coverage] =
    DIVIDE(
        CALCULATE(
            DISTINCTCOUNT('fact_knowledge_procedure'[topic_id]),
            'fact_knowledge_procedure'[approved_flag] = TRUE()
        ),
        DISTINCTCOUNT('fact_knowledge_procedure'[topic_id])
    )

MEASURE 'dim_kpi_target'[KPI-KNW-02 Median Retrieval Seconds] =
    DIVIDE(MEDIAN('fact_knowledge_usage'[retrieval_ms]), 1000.0)

MEASURE 'dim_kpi_target'[KPI-TRUST-01 Portfolio Acceptance Rate] =
    DIVIDE(
        CALCULATE(
            COUNTROWS('fact_ai_decision_audit'),
            'fact_ai_decision_audit'[recommendation_status] IN {"ACCEPTED", "MODIFIED"}
        ),
        COUNTROWS('fact_ai_decision_audit')
    )

MEASURE 'dim_kpi_target'[KPI-ADO-01 Weekly Active User Rate] =
    DIVIDE(
        CALCULATE(
            DISTINCTCOUNT('fact_platform_usage'[user_subject]),
            'fact_platform_usage'[active_flag] = TRUE()
        ),
        CALCULATE(
            DISTINCTCOUNT('fact_platform_usage'[user_subject]),
            'fact_platform_usage'[target_user_flag] = TRUE()
        )
    )

MEASURE 'dim_kpi_target'[KPI-GOV-01 Audit Completeness] =
    DIVIDE(
        CALCULATE(
            COUNTROWS('fact_ai_decision_audit'),
            'fact_ai_decision_audit'[complete_audit_flag] = TRUE()
        ),
        COUNTROWS('fact_ai_decision_audit')
    )

-- Supporting operational/report measures from the UX specification.

MEASURE 'dim_kpi_target'[Throughput t per h] =
    DIVIDE(
        SUM('fact_production_shift'[total_tons]),
        DIVIDE(SUM('fact_production_shift'[runtime_minutes]), 60.0)
    )

MEASURE 'dim_kpi_target'[Availability] =
    DIVIDE(
        SUM('fact_production_shift'[runtime_minutes]),
        SUM('fact_production_shift'[planned_minutes])
    )

MEASURE 'dim_kpi_target'[Performance] =
    DIVIDE(
        SUM('fact_production_shift'[total_tons]),
        SUMX(
            'fact_production_shift',
            'fact_production_shift'[ideal_rate_tph]
                * DIVIDE('fact_production_shift'[runtime_minutes], 60.0)
        )
    )

MEASURE 'dim_kpi_target'[Quality Rate] =
    DIVIDE(
        SUM('fact_production_shift'[good_tons]),
        SUM('fact_production_shift'[total_tons])
    )

MEASURE 'dim_kpi_target'[OEE] =
    [Availability] * [Performance] * [Quality Rate]

MEASURE 'dim_kpi_target'[Energy EUR per t] =
    DIVIDE(
        SUM('fact_energy_daily'[energy_cost_eur]),
        SUM('fact_energy_daily'[crude_steel_tons])
    )

MEASURE 'dim_kpi_target'[On-Time Rate] =
    DIVIDE(
        SUM('fact_production_shift'[on_time_orders]),
        SUM('fact_production_shift'[total_orders])
    )

MEASURE 'dim_kpi_target'[Latest RUL P50 Days] =
    MAXX(
        TOPN(1, 'fact_furnace_rul', 'fact_furnace_rul'[scored_at], DESC),
        'fact_furnace_rul'[rul_days_p50]
    )

MEASURE 'dim_kpi_target'[Latest Lining Risk] =
    MAXX(
        TOPN(1, 'fact_furnace_rul', 'fact_furnace_rul'[scored_at], DESC),
        'fact_furnace_rul'[risk_score]
    )

MEASURE 'dim_kpi_target'[Projected Savings EUR] =
    SUM('fact_dispatch_recommendation'[expected_cost_avoidance_eur])

MEASURE 'dim_kpi_target'[Shiftable MW] =
    SUM('fact_dispatch_recommendation'[shiftable_mw])

MEASURE 'dim_kpi_target'[First-Pass Yield] =
    DIVIDE(
        SUM('fact_quality_yield'[first_pass_good_tons]),
        SUM('fact_quality_yield'[attempted_tons])
    )

MEASURE 'dim_kpi_target'[Defect PPM] =
    DIVIDE(
        SUM('fact_quality_yield'[defect_count]) * 1000000.0,
        SUM('fact_quality_yield'[produced_units])
    )

MEASURE 'dim_kpi_target'[CO2 t per day] =
    AVERAGEX(VALUES('dim_calendar'[date_key]), [Total CO2e t])

MEASURE 'dim_kpi_target'[ETS Allowances Remaining t] =
    SUM('fact_emissions_daily'[free_allocation_t])
        - SUM('fact_emissions_daily'[total_co2e_t])
