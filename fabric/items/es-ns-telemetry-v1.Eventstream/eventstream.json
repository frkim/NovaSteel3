      "name": "route-hot-schemas",
      "type": "SQL",
      "inputNodes": [
        { "name": "novasteel-raw" }
      ],
      "properties": {
        "query": "--Init Query\nSELECT * INTO [telemetry-stream] FROM [novasteel-raw] WHERE schema_name = 'novasteel.telemetry.v1';\nSELECT * INTO [alarm-stream] FROM [novasteel-raw] WHERE schema_name = 'novasteel.alarm.v1';\nSELECT * INTO [gateway-health-stream] FROM [novasteel-raw] WHERE schema_name = 'novasteel.gateway-health.v1';\nSELECT * INTO [model-inference-stream] FROM [novasteel-raw] WHERE schema_name = 'novasteel.model-inference.v1';\nSELECT * INTO [quarantine-stream] FROM [novasteel-raw] WHERE schema_name = 'novasteel.quarantine.v1';",
        "advancedSettings": {
          "eventsOutOfOrderPolicy": "Adjust",
          "eventsOutOfOrderMaxDelayInSeconds": 5,
          "eventsLateArrivalMaxDelayInSeconds": 300
        }
      }
    }
  ],
