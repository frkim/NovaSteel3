{
  "$schema": "./environment.schema.json",
  "schemaVersion": 1,
  "environment": "<dev|test|demo|prod>",
  "region": "Sweden Central",
  "dataClassification": "<SYNTHETIC|APPROVED_TEST|CONFIDENTIAL_OPERATIONAL>",
  "syntheticOnly": true,
  "tenantId": "00000000-0000-0000-0000-000000000000",
  "subscriptionId": "00000000-0000-0000-0000-000000000000",
  "capacity": {
    "name": "cap-novasteel-<env>-sc",
    "resourceGroupName": "rg-ns-<env>-fabric",
    "fabricCapacityId": "00000000-0000-0000-0000-000000000000",
    "armResourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-ns-<env>-fabric/providers/Microsoft.Fabric/capacities/cap-novasteel-<env>-sc",
    "sku": "F2"
  },
  "authentication": {
    "mode": "AzureCli",
    "managedIdentityClientId": ""
  },
  "workspaces": {
    "rtiIngress": { "displayName": "NS-<env>-RTI-Ingress", "id": "" },
    "dataCore": { "displayName": "NS-<env>-DataCore", "id": "" },
    "ml": { "displayName": "NS-<env>-ML", "id": "" },
    "analytics": { "displayName": "NS-<env>-Analytics", "id": "" }
  },
  "items": {
    "eventhouseOperations": { "displayName": "evh-ns-operations", "id": "" },
    "kqlOperations": { "displayName": "kql-ns-operations", "id": "" },
    "landingLakehouse": { "displayName": "lh-ns-landing", "id": "" },
    "coreLakehouse": { "displayName": "lh-ns-core", "id": "" },
    "eventstreamTelemetry": { "displayName": "es-ns-telemetry-v1", "id": "" },
    "semanticOperations": { "displayName": "sm-ns-operations", "id": "" }
  },
  "onelake": {
    "landingTablesUri": "abfss://<rti-workspace-guid>@onelake.dfs.fabric.microsoft.com/<landing-lakehouse-guid>/Tables",
    "coreTablesUri": "abfss://<datacore-workspace-guid>@onelake.dfs.fabric.microsoft.com/<core-lakehouse-guid>/Tables"
  },
  "retention": {
    "telemetryHot": "90d",
    "alarmHot": "365d",
    "gatewayHealthHot": "30d",
