      "mes": "",
      "lims": "",
      "cmms": "",
      "market": "",
      "powerBi": ""
    }
  },
  "deploymentOptions": {
    "createWorkspaces": true,
    "assignCapacity": true,
    "deployRti": true,
    "deployLakehouses": true,
    "deployNotebooks": true,
    "deployPipelines": true,
    "deploySemanticModel": false,
    "semanticModelBindingValidated": false,
    "applyIngressPublisherAclWithFabricCli": false,
    "runInitializationJobs": false
