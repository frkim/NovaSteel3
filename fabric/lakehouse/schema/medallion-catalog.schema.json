{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novasteel.example/schemas/medallion-catalog.schema.json",
  "title": "NovaSteel medallion table catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "zones"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "contractVersion": { "type": "string" },
    "zones": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "lakehouse", "tables"],
        "properties": {
          "name": { "enum": ["bronze", "silver", "gold", "operations"] },
          "lakehouse": { "enum": ["landingLakehouse", "coreLakehouse"] },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "grain",
                "primaryKey",
                "idempotencyKey",
                "partitionBy",
                "columns"
              ],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                "grain": { "type": "string" },
                "primaryKey": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "idempotencyKey": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "partitionBy": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "type", "nullable", "description"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "nullable": { "type": "boolean" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
