# .NET
**/bin/
**/obj/

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
.pytest_cache/

# Node.js
**/node_modules/
**/dist/
apps/portal-shell/wwwroot/analytics-mfe/*
!apps/portal-shell/wwwroot/analytics-mfe/.gitkeep

# Local configuration and editor state
*.user
*.suo
.vs/
.idea/
.vscode/
*.local.json

# Simulator scratch/test output (never committed)
/output/
tests/simulator/.tmp/*
!tests/simulator/.tmp/README.md

# Local CI validation output
/artifacts/
/.validation-venv/

# Source artwork for the corporate-website process diagrams and photography.
# Only the optimised web renditions under apps/portal-shell/wwwroot/media are
# committed. See docs/images/README.md to regenerate them.
# The logo sources in docs/images/logo/ are small and ARE tracked, matching
# docs/AxelorMetal-web/logo/.
/docs/images/*.png
/docs/images/*.jpg
/docs/images/*.jpeg
