@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_rootId" class="analytics-mfe-root" aria-label="NovaSteel analytics dashboard" aria-busy="@(!_mounted)"></div>

@code {
    [Parameter, EditorRequired]
    public AnalyticsBridgeContext Context { get; set; } = default!;

    [Parameter]
    public EventCallback<AnalyticsEvent> OnEvent { get; set; }

    private readonly string _rootId = $"ns-analytics-root-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<AnalyticsBridge>? _selfReference;
    private string? _renderedContext;
    private bool _mounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var serializedContext = JsonSerializer.Serialize(Context);
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/analyticsBridge.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("mount", _rootId, Context, _selfReference);
            _mounted = true;
            _renderedContext = serializedContext;
            return;
        }

        if (_mounted && _module is not null && serializedContext != _renderedContext)
        {
            await _module.InvokeVoidAsync("update", Context);
            _renderedContext = serializedContext;
        }
    }

    [JSInvokable]
    public Task ReceiveEvent(string eventType, JsonElement payload) =>
        OnEvent.InvokeAsync(new AnalyticsEvent(eventType, payload));

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _rootId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser was already closed or reloaded.
            }
        }

        _selfReference?.Dispose();
    }
}
