@inherits LayoutComponentBase
@implements IDisposable
@inject ShellState Shell
@inject ShellPreferenceStore Preferences
@inject CapacityState Capacity
@inject NavigationManager Navigation

<div class="shell">
    <a class="skip-link" href="#shell-main-content">Skip to content</a>
    <header class="shell-topbar">
        <NavLink class="brand" href="@Shell.RouteFor("command-center", null)" aria-label="NovaSteel Command Center">
            <picture class="brand-logo">
                <source srcset="brand/novasteel-logo-full-dark.png" media="(prefers-color-scheme: dark)" />
                <img src="brand/novasteel-logo-full.png" alt="NovaSteel" class="brand-logo-img" />
            </picture>
        </NavLink>

        <label class="topbar-field topbar-field-site">
            <span class="sr-only">Site</span>
            <select value="@Shell.Site" @onchange="OnSiteChanged" aria-label="Selected site">
                @foreach (var site in ShellState.Sites)
                {
                    <option value="@site">@ShellState.SiteLabel(site)</option>
                }
            </select>
        </label>

        <label class="topbar-field">
            <span class="sr-only">Persona</span>
            <select value="@Shell.PrimaryPersona" @onchange="OnPersonaChanged" aria-label="Selected persona">
                @foreach (var persona in Shell.Auth.CurrentUser.Personas)
                {
                    <option value="@persona">@ShellState.PersonaLabel(persona)</option>
                }
            </select>
        </label>

        <form class="topbar-search" role="search" @onsubmit="OnSearchSubmit" @onsubmit:preventDefault="true">
            <span class="sr-only">Search everything</span>
            <input type="search" placeholder="Search…" @bind="_searchQuery" aria-label="Search everything" />
        </form>

        <div class="topbar-spacer"></div>

        <button class="capacity-pill capacity-pill-@Capacity.Status.State.ToLowerInvariant()" type="button"
                @onclick="Capacity.TogglePanel"
                aria-haspopup="dialog" aria-expanded="@Capacity.PanelOpen"
                title="Open Fabric capacity control">
            <span aria-hidden="true">●</span> Fabric: @Capacity.Status.State
        </button>

        <button class="icon-button" type="button" @onclick="OpenAlerts" aria-label="Alerts">
            🔔<span class="alert-count">@_openAlerts</span>
        </button>

        <button class="theme-icon-button" type="button" @onclick="Shell.CycleTheme"
                title="@ThemeTitle" aria-label="@ThemeTitle">
            @((MarkupString)ThemeIcon)
        </button>

        <LocaleListbox Locales="ShellState.Locales" Value="@Shell.Locale" ValueChanged="OnLocaleChanged"
                       AriaLabel="Selected locale" Compact="true" Class="locale-field" />

        <button class="bff-pill @BffPillClass" type="button" @onclick="ReprobeBff"
                title="@BffPillTitle" aria-label="@BffPillTitle">
            <span aria-hidden="true">●</span> @BffPillLabel
        </button>

        <details class="account-menu">
            <summary aria-label="Demo identity">
                <span class="account-avatar" aria-hidden="true">@Initials(Shell.Auth.CurrentUser.DisplayName)</span>
            </summary>
            <div class="account-popover">
                <p class="account-name">@Shell.Auth.CurrentUser.DisplayName</p>
                <p class="account-sub">@(Shell.Auth.IsSignedIn ? "Signed in (demo identity)" : "Signed out")</p>
                <p class="account-label">Roles</p>
                <ul class="account-list">
                    @foreach (var role in Shell.Auth.CurrentUser.Roles)
                    {
                        <li>@role</li>
                    }
                </ul>
                <button class="account-action" type="button" @onclick="Shell.Auth.ToggleSignIn">
                    @(Shell.Auth.IsSignedIn ? "Sign out (demo)" : "Sign in (demo)")
                </button>
            </div>
        </details>

        <div class="hamburger-wrapper">
            <button class="hamburger-button" type="button" @ref="_hamburgerButton"
                    @onclick="ToggleHamburger" @onkeydown="OnHamburgerKeyDown"
                    aria-haspopup="menu" aria-expanded="@_hamburgerOpen"
                    aria-label="Main menu">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>
            @if (_hamburgerOpen)
            {
                <div class="hamburger-backdrop" @onclick="CloseHamburger"></div>
                <div class="hamburger-menu" role="menu" @onkeydown="OnMenuKeyDown">
                    <button class="hamburger-item" role="menuitem" type="button" @onclick="OpenSettings">
                        Settings
                    </button>
                    <button class="hamburger-item" role="menuitem" type="button" @onclick="ResetWorkspace">
                        Reset workspace layout
                    </button>
                    <button class="hamburger-item" role="menuitem" type="button" @onclick="ShowAbout">
                        About NovaSteel
                    </button>
                </div>
            }
        </div>
    </header>

    <div class="shell-content">
        <aside class="shell-nav" aria-label="Persona navigation">
            <nav>
                @{ string? lastGroup = null; }
                @foreach (var item in Shell.VisibleNavigationItems)
                {
                    @if (item.Group != lastGroup)
                    {
                        lastGroup = item.Group;
                        <span class="nav-group-heading" aria-hidden="true">@item.Group</span>
                    }
                    <NavLink class="@NavLinkClass(item)"
                             href="@Shell.RouteFor(item.Section, item.DefaultSubView)"
                             Match="NavLinkMatch.All"
                             aria-current="@(IsActive(item) ? "page" : null)">
                        <span aria-hidden="true">@item.Symbol</span>
                        <span>@item.Label</span>
                    </NavLink>
                }
            </nav>
        </aside>

        <main class="shell-main" id="shell-main-content">
            <div class="breadcrumbs" aria-label="Breadcrumb">
                @Shell.Site.ToUpperInvariant() <span aria-hidden="true">›</span> @Shell.ActivePersona
                @if (!string.IsNullOrWhiteSpace(Shell.SubView))
                {
                    <span aria-hidden="true">›</span> @Shell.SubView
                }
            </div>
            @if (Shell.LastToast is not null)
            {
                <div class="shell-toast" role="status">@Shell.LastToast.Message</div>
            }
            @Body
        </main>
    </div>

    <footer class="shell-footer">
        <span>BFF @Shell.BffBaseUrl · @BffFooterStatus</span>
        <span>WCAG 2.2 AA target · synthetic evidence only</span>
    </footer>
</div>

<CapacityPanel />
<SettingsDialog Open="_settingsOpen" OpenChanged="OnSettingsOpenChanged" />

@code {
    private string _searchQuery = string.Empty;
    private readonly int _openAlerts = 3;
    private bool _hamburgerOpen;
    private bool _settingsOpen;
    private bool _focusHamburgerAfterSettingsClose;
    private ElementReference _hamburgerButton;

    // The portal is always cloud-backed; this indicator states honestly whether
    // the BFF answered, and lets the user re-check on demand.
    private Task ReprobeBff() => Shell.ProbeBffAsync(announceSuccess: true);

    private string BffPillLabel => Shell.BffProbeInFlight
        ? "BFF…"
        : Shell.BffReachable switch
        {
            true => "BFF online",
            false => "BFF offline",
            _ => "BFF",
        };

    private string BffPillClass => Shell.BffProbeInFlight
        ? "bff-pill-probing"
        : Shell.BffReachable switch
        {
            true => "bff-pill-online",
            false => "bff-pill-offline",
            _ => "bff-pill-unknown",
        };

    private string BffPillTitle => Shell.BffProbe is { } probe
        ? probe.Reachable
            ? $"Connected to {Shell.BffBaseUrl}. Click to re-check."
            : $"{Shell.BffBaseUrl} unreachable ({probe.Detail}). Screens use bundled synthetic data. Click to retry."
        : $"Checking {Shell.BffBaseUrl}…";

    private string BffFooterStatus => Shell.BffProbeInFlight
        ? "checking connection…"
        : Shell.BffReachable switch
        {
            true => "connected",
            false => "unreachable — using bundled synthetic data",
            _ => "connection not yet checked",
        };

    protected override async Task OnInitializedAsync()
    {
        Shell.Changed += OnShellStateChanged;
        Capacity.Changed += OnShellStateChanged;
        // The portal is always cloud-backed, so the reachability probe runs on
        // start rather than behind a mode switch; the indicator updates when it
        // lands. Fire-and-forget so the first render is not blocked on the BFF.
        _ = Shell.ProbeBffAsync(announceSuccess: false);
        // Stored preferences are applied before the first capacity call so the
        // panel is fetched in the language the visitor last chose.
        await Preferences.InitializeAsync();
        await Capacity.RefreshAsync(Shell.Locale);
    }

    private void OnShellStateChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHamburgerAfterSettingsClose)
        {
            _focusHamburgerAfterSettingsClose = false;
            await _hamburgerButton.FocusAsync();
        }
    }

    private void OnSiteChanged(ChangeEventArgs args)
    {
        Shell.SetSite(args.Value?.ToString() ?? Shell.Site);
        Navigation.NavigateTo(Shell.RouteFor(Shell.Section, Shell.SubView));
    }

    private void OnPersonaChanged(ChangeEventArgs args)
    {
        var persona = args.Value?.ToString() ?? Shell.PrimaryPersona;
        Shell.SetPrimaryPersona(persona);
        Navigation.NavigateTo(Shell.RouteForPersona(persona));
    }

    private void OnLocaleChanged(string locale)
    {
        Shell.SetLocale(locale);
    }

    private void OnSearchSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            Shell.PublishToast("info", $"Search '{_searchQuery}' — use in-view search for scoped results.");
            Navigation.NavigateTo(Shell.RouteFor("command-center", null));
        }
    }

    private void OpenAlerts()
    {
        Navigation.NavigateTo(Shell.RouteFor("command-center", null));
    }

    // Theme icon button helpers
    private string ThemeTitle => Shell.ThemeMode switch
    {
        ThemeMode.Light => "Theme: light. Click to switch to dark.",
        ThemeMode.Dark => "Theme: dark. Click to switch to system.",
        _ => "Theme: system. Click to switch to light."
    };

    private string ThemeIcon => Shell.ThemeMode switch
    {
        ThemeMode.Light => """<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>""",
        ThemeMode.Dark => """<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>""",
        _ => """<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/><path d="M16 12a4 4 0 0 0-4-4" opacity="0.5"/></svg>"""
    };

    // Hamburger menu
    private void ToggleHamburger() => _hamburgerOpen = !_hamburgerOpen;
    private void CloseHamburger() => _hamburgerOpen = false;

    private void OnHamburgerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseHamburger();
    }

    private void OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseHamburger();
    }

    private void OpenSettings()
    {
        CloseHamburger();
        _settingsOpen = true;
    }

    private Task OnSettingsOpenChanged(bool open)
    {
        if (_settingsOpen && !open)
        {
            _focusHamburgerAfterSettingsClose = true;
        }

        _settingsOpen = open;
        return Task.CompletedTask;
    }

    private void ResetWorkspace()
    {
        CloseHamburger();
        Shell.PublishToast("info", "Reset workspace layout: use the reset control on the dashboard header.");
    }

    private void ShowAbout()
    {
        CloseHamburger();
        Shell.PublishToast("info",
            "NovaSteel v1.0 — Demo platform for AxelorMetal. All data is synthetic.");
    }

    private bool IsActive(ShellNavItem item) =>
        string.Equals(item.Section, Shell.Section, StringComparison.OrdinalIgnoreCase);

    private string NavLinkClass(ShellNavItem item) =>
        IsActive(item) ? "shell-nav-link active" : "shell-nav-link";

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    }

    public void Dispose()
    {
        Shell.Changed -= OnShellStateChanged;
        Capacity.Changed -= OnShellStateChanged;
    }
}
