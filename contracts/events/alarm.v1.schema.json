{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novasteel.example/contracts/events/alarm.v1.schema.json",
  "title": "NovaSteel alarm event v1",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    },
    {
      "properties": {
        "schema_name": {
          "const": "novasteel.alarm.v1"
        },
        "payload": {
          "type": "object",
          "description": "Alarm lifecycle event. Additive fields are allowed within v1.",
          "required": [
            "type",
            "severity",
            "message",
            "status"
          ],
          "properties": {
            "type": {
              "const": "alarm.event"
            },
            "alert_id": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": [
                "CRITICAL",
                "WARNING",
                "INFO"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "status": {
              "type": "string",
              "enum": [
                "OPEN",
                "ACKNOWLEDGED",
                "WORK_ORDER_LINKED",
                "MITIGATED",
                "CLOSED"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "actor_type": {
              "type": "string",
              "enum": [
                "DEMO_USER",
                "SYSTEM"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "transitioned_at": {
              "type": "string",
              "format": "date-time"
            },
            "work_order_id": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
