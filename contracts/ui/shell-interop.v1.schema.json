{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novasteel.example/contracts/ui/shell-interop.v1.schema.json",
  "title": "NovaSteel shell-to-analytics interop v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "themeMode",
    "locale",
    "activePersona",
    "site",
    "tokenRef",
    "bridgeVersion",
    "navigation"
  ],
  "properties": {
    "themeMode": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "activePersona": {
      "type": "string",
      "minLength": 1
    },
    "site": {
      "type": "string",
      "minLength": 1
    },
    "tokenRef": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque shell-managed token reference; never a bearer value."
    },
    "bffBaseUrl": {
      "type": ["string", "null"],
      "description": "Optional shell-provided Backend-for-Frontend base URL. When absent the microfrontend resolves a runtime global, a build env var, or same-origin, then falls back to local synthetic fixtures."
    },
    "permittedActions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional server-authoritative permitted-action set used to hide/disable role-gated controls. When absent the microfrontend assumes the full demo reader set."
    },
    "bridgeVersion": {
      "const": "1.0"
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "site"
      ],
      "properties": {
        "section": {
          "type": "string"
        },
        "subView": {
          "type": [
            "string",
            "null"
          ]
        },
        "site": {
          "type": "string"
        }
      }
    }
  }
}
