{
  "contractVersion": 2,
  "zone": "gold",
  "classificationRule": "Stable star-schema facts used by the Direct Lake semantic model and BFF read projections.",
  "keyDesign": {
    "policy": "natural-keys",
    "supersedes": "contractVersion 1 declared surrogate dimension keys (plant_key, grade_key, asset_key).",
    "rationale": "The deterministic analytical demo (simulator/analytics.py) emits gold facts directly from the scenario and runs NO SCD2 dimension load. In a full medallion the surrogate *_key columns are minted by SCD2 dimension tables (see dim_plant in silver.v1.json); with no dimension load running, a surrogate key would reference a dimension row that nothing produces -- a dangling, fictional key. The deployed lh_novasteelv3_core Delta DDL (fabric/notebooks/ns-initialize-lakehouses.Notebook) and the loader (fabric/notebooks/ns-load-analytical-gold.Notebook) therefore key on the natural business columns (plant_id, grade_code, date_key, shift_id, inference_id, ...). This contract v2 declares those same natural keys so the contract, the physical schema, the generator (simulator/analytics.py::IDEMPOTENCY_KEYS) and the validator (simulator/validators/gold_contract.py) all agree. If an SCD2 dimension load is added later, reintroduce the surrogate keys under a new contract version.",
    "enforcedBy": "simulator/validators/gold_contract.py::validate_gold_contract asserts produced tables against this file's columns, primaryKey and idempotencyKey."
  },
  "tables": [
    {
